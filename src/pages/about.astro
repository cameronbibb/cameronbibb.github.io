---
import MainLayout from "../layouts/MainLayout.astro";
import * as aboutPost from "@content/about-post.md";
const { title, updated } = aboutPost.frontmatter;
---

<MainLayout title="About" path="/about">
  <main class="px-6 lg:px-12 py-12">
    <div
      class="max-w-2xl mx-auto flex flex-col space-y-5 font-body text-base pb-5"
    >
      <h1 class="font-body text-4xl lg:text-5xl font-bold mb-6">About Me</h1>
      <div class="flex flex-col gap-4 md-content"><aboutPost.Content /></div>
      <div class="italic text-right border-t-1 border-accent-500">
        updated: {updated}
      </div>
    </div>
  </main>
</MainLayout>
