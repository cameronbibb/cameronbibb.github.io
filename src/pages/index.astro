---
import Header from "../components/Header";
import MainLayout from "../layouts/MainLayout.astro";
---

<MainLayout title="Software Engineer" path="/">
  <main>
    <div
      class="flex flex-col items-center gap-12 md:gap-12 mt-20 sm:mt-30 mb-40 mx-8"
    >
      <img src="/mustache-logo-new.svg" class="w-[200px] sm:w-[300px] h-auto" />
      <div class="text-lg text-center max-w-prose space-y-6">
        <h1 class="font-mono text-2xl mb-0">SOFTWARE ENGINEER</h1>
        <p class="font-mono text-xs">
          <a href="/about" class="hover:text-primary-500"
            >(among other things)</a
          >
        </p>
        <p class="text-base sm:text-lg">
          ...but don't take my word for it! Take a look at <a
            href="/work"
            class="text-primary-500 hover:underline hover:decoration-accent-500 hover:underline-offset-8"
            >my work</a
          >. I have been on a journey through many career paths in life but my
          path has always included or returned me to tech.
        </p>
        <div>
          <a
            href="/about"
            class="group inline-flex items-center text-primary-500 decoration-accent-500 hover:underline hover:underline-offset-8"
            >Read more about my journey <span
              class="group-hover:text-accent-500">→</span
            ></a
          >
        </div>
      </div>
    </div>
    <!-- <div>
      Other items to add:
      <ul>
        <li>most recent blog post</li>
      </ul>
    </div> -->
  </main>
</MainLayout>
