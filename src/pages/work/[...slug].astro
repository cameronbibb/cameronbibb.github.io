---
import Layout from "../../layouts/Layout.astro";
import Header from "../../components/Header";
import { getCollection, render } from "astro:content";
import { formatYears } from "../../lib/dates";
import { hasDetailPage } from "../../lib/work";

export async function getStaticPaths() {
  const work = await getCollection("work");

  return work.filter(hasDetailPage).map((entry) => ({
    params: { slug: entry.id },
    props: { entry },
  }));
}

const { entry } = Astro.props;
const { Content } = await render(entry);
const years = formatYears(entry.data.startYear, entry.data.endYear);
---

<Layout title={entry.data.title}>
  <Header currentPath="/work" />
  <main class="min-h-screen px-6 lg:px-12 py-12">
    <article class="max-w-3xl mx-auto px-6 py-16">
      <a
        href="/work"
        class="font-mono text-xs text-paper-dim/60 hover:text-accent-500"
      >
        ← work
      </a>

      <header class="flex items-center gap-4 mt-8 mb-4">
        <h1 class="font-mono text-4xl lg:text-5xl">{entry.data.title}</h1>
        <span class="font-mono text-xs text-paper-dim/60 ml-auto">{years}</span>
      </header>

      <p class="text-paper-dim mb-12">{entry.data.summary}</p>

      <div class="prose-content">
        <Content />
      </div>
    </article>
  </main>
</Layout>
