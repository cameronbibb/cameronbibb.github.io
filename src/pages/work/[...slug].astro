---
import MainLayout from "@layouts/MainLayout.astro";
import { getCollection, render } from "astro:content";
import { formatYears } from "@lib/dates";
import { hasDetailPage } from "@lib/work";

export async function getStaticPaths() {
  const work = await getCollection("work");

  return work.filter(hasDetailPage).map((entry) => ({
    params: { slug: entry.id },
    props: { entry },
  }));
}

const { entry } = Astro.props;
const { Content } = await render(entry);
const years = formatYears(entry.data.startYear, entry.data.endYear);
---

<MainLayout title={entry.data.title} path=`/work/${entry.id}`>
  <main class="px-6 lg:px-12 py-12">
    <div class="max-w-2xl mx-auto">
      <a href="/work" class="font-mono text-xs hover:text-accent-500">
        ← work
      </a>
      <article>
        <header class="flex justify-start items-center">
          <h1 class="font-mono text-4xl lg:text-5xl font-bold mb-6 mt-8">
            {entry.data.title}
          </h1>
          <div class="font-mono text-xs text-gray-400 ml-2">{years}</div>
        </header>

        <p class="bg-gray-300 text-navy-950 font-mono mb-6 p-4">
          {entry.data.summary}
        </p>
        <div class="md-content">
          <Content />
        </div>
      </article>
    </div>
  </main>
</MainLayout>
