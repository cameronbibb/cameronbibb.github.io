---
import Header from "../components/Header";
import { ThemePlayground } from "../components/ThemePlayground";
import MainLayout from "../layouts/MainLayout.astro";
---

<MainLayout title="Style Guide" path="/style-guide">
  <main class="px-6 lg:px-12 py-12">
    <div class="max-w-5xl mx-auto space-y-4">
      <h1 class="text-4xl lg:text-5xl font-bold text-white">Style Guide</h1>
      <p class="text-gray-400">
        Live reference for the tokens defined in
        <code class="text-primary-400">src/styles/global.css</code>.
      </p>
      <ThemePlayground client:load />
    </div>
  </main>
</MainLayout>
