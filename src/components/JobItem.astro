---
import type { CollectionEntry } from "astro:content";
import { formatYears } from "../lib/dates";

interface Props {
  entry: CollectionEntry<"work">;
}

const { entry } = Astro.props;
const years = formatYears(entry.data.startYear, entry.data.endYear);
---

<details class="group border-b border-navy-700/40">
  <summary
    class="cursor-pointer list-none flex items-center justify-between py-4"
  >
    <span class="flex items-baseline gap-3">
      <span class="text-paper-dim group-hover:text-paper transition-colors">
        {entry.data.title}
      </span>
      <span class="font-mono text-xs text-paper-dim/60">
        {years}
      </span>
    </span>
    <span
      class="font-mono text-xs text-paper-dim/60 group-open:rotate-45 transition-transform"
    >
      +
    </span>
  </summary>
  <div class="pb-5 pr-8 text-paper-dim prose-content">
    <slot />
  </div>
</details>
